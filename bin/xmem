#!/usr/bin/env bash
set -euo pipefail
SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
  TARGET="$(readlink "$SCRIPT")"
  case "$TARGET" in
    /*) SCRIPT="$TARGET" ;;
    *) SCRIPT="$DIR/$TARGET" ;;
  esac
done
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
if [ -n "${XMEM_PYTHON:-}" ]; then
  PYTHON_BIN="$XMEM_PYTHON"
elif command -v python >/dev/null 2>&1 && python -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
  PYTHON_BIN=python
else
  PYTHON_BIN=python3
fi
if [ "${1:-}" = lookup ]; then
  shift
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" PYTHONDONTWRITEBYTECODE=1 exec "$PYTHON_BIN" -B -m xmem.readonly "$@"
fi
if [ "${1:-}" = memory-scope ]; then
  shift
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" PYTHONDONTWRITEBYTECODE=1 exec "$PYTHON_BIN" -B -m xmem.memory_scope "$@"
fi
if [ "${STRIDE_EXECUTION_CONTEXT:-}" = stride-v1 ] || [ "${1:-}" = agent-hook ] || [ "${1:-}" = gateway ]; then
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" PYTHONDONTWRITEBYTECODE=1 exec "$PYTHON_BIN" -B -m xmem "$@"
fi
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON_BIN" -m xmem "$@"
